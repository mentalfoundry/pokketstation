#include <windows.h>
#include "resource.h"

/* Listed first so it becomes the .exe's default icon (Explorer, taskbar,
   Alt-Tab) - main.c also explicitly loads it and sends WM_SETICON so the
   window's title bar shows it too, since SDL's own window class doesn't
   pick up exe resource icons on its own. */
IDI_MAINICON ICON "app.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Load BIOS...",       ID_FILE_OPEN_BIOS
        MENUITEM "Open &App/Card...",   ID_FILE_OPEN_APP
        MENUITEM "&Reset",              ID_FILE_RESET
        MENUITEM SEPARATOR
        MENUITEM "&Save State",         ID_FILE_QUICK_SAVE
        MENUITEM "&Load State",         ID_FILE_QUICK_LOAD
        MENUITEM SEPARATOR
        MENUITEM "E&xit",               ID_FILE_EXIT
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Edit &Hardware ID...", ID_TOOLS_EDIT_HWID
        MENUITEM "&Remap Controls...", ID_TOOLS_REMAP_CONTROLS
        MENUITEM SEPARATOR
        /* This emulator's own output level, not a PocketStation setting, so it
           stays usable on any BIOS. It also replaces what used to be a Volume
           Override group here: forcing the emulated machine's own volume byte
           only ever bought three coarse steps that this covers better. */
        /* Two sides of the same thing, so they sit at the same level: Volume is
           how loud the output is, Speaker is how it is voiced. The eleven
           volume steps are behind their own header rather than listed here
           directly - inlined, they buried Speaker under a wall of percentages
           and made it easy to miss that it existed at all. */
        POPUP "&Sound"
        BEGIN
            POPUP "&Volume"
            BEGIN
                MENUITEM "&Mute",   ID_TOOLS_SOUND_BASE + 0
                MENUITEM SEPARATOR
                MENUITEM "10%",     ID_TOOLS_SOUND_BASE + 1
                MENUITEM "20%",     ID_TOOLS_SOUND_BASE + 2
                MENUITEM "30%",     ID_TOOLS_SOUND_BASE + 3
                MENUITEM "40%",     ID_TOOLS_SOUND_BASE + 4
                MENUITEM "50%",     ID_TOOLS_SOUND_BASE + 5
                MENUITEM "60%",     ID_TOOLS_SOUND_BASE + 6
                MENUITEM "70%",     ID_TOOLS_SOUND_BASE + 7
                MENUITEM "80%",     ID_TOOLS_SOUND_BASE + 8
                MENUITEM "90%",     ID_TOOLS_SOUND_BASE + 9
                MENUITEM "&Full",   ID_TOOLS_SOUND_BASE + 10
            END
            /* How the output is voiced, as opposed to how loud it is. The
               real unit's speaker is tiny and reproduces very little low end;
               a PC speaker reproduces all of it, which is what makes the raw
               output sound muddy next to hardware. See SPEAKER_SIM_PRESETS in
               main.c. */
            POPUP "&Speaker"
            BEGIN
                MENUITEM "F&ull Range (raw DAC output)", ID_TOOLS_SPEAKER_BASE + 0
                MENUITEM SEPARATOR
                MENUITEM "&Light",                       ID_TOOLS_SPEAKER_BASE + 1
                MENUITEM "&PocketStation Speaker",       ID_TOOLS_SPEAKER_BASE + 2
                MENUITEM "&Tinny",                       ID_TOOLS_SPEAKER_BASE + 3
            END
        END
        MENUITEM SEPARATOR
        POPUP "Date/&Time Override"
        BEGIN
            MENUITEM "&Default (set in system menu)", ID_TOOLS_DATETIME_DEFAULT
            MENUITEM SEPARATOR
            MENUITEM "&OS Date/Time", ID_TOOLS_DATETIME_OS
        END
    END
    POPUP "&IR Link"
    BEGIN
        MENUITEM "&Host Session", ID_IR_HOST
        MENUITEM "&Connect", ID_IR_CONNECT
        MENUITEM "&Disconnect", ID_IR_DISCONNECT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Native Size (1x)", ID_VIEW_NATIVE_SIZE
        MENUITEM "&Double Size (2x)", ID_VIEW_DOUBLE_SIZE
        MENUITEM SEPARATOR
        POPUP "&Colors"
        BEGIN
            MENUITEM "&Classic (LCD-style)", ID_COLORS_CLASSIC
            MENUITEM "&Light (black on white)", ID_COLORS_STANDARD
            MENUITEM "&Dark (white on black)", ID_COLORS_REVERSED
            MENUITEM SEPARATOR
            /* Everything the three presets do not cover lives behind this one
               item, sprite shadows included - they are part of how the LCD
               looks, not a separate feature, and their color has to be picked
               against the scheme it sits on anyway. */
            MENUITEM "&Advanced Colors...", ID_COLORS_ADVANCED
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About pokketstation...", ID_HELP_ABOUT
    END
END

IDD_HWID DIALOGEX 0, 0, 190, 70
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Hardware ID"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "8 hex digits (0-9, A-F):", -1, 7, 7, 150, 10
    EDITTEXT        IDC_HWID_EDIT, 7, 20, 100, 14, ES_AUTOHSCROLL | ES_UPPERCASE
    DEFPUSHBUTTON   "OK",     IDOK,     30, 46, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 105, 46, 50, 14
END

/* Everything about how the LCD looks that the three presets do not cover, in
   one dialog, arranged as two tiers.
   Tier one, always visible: pick one screen color and the active pixel and
   sprite shadow colors are matched to it (see derive_theme_colors in main.c),
   with a live preview and the sprite-shadow toggle. That is the whole
   decision for most people.
   Tier two, the Custom Colors group: all three colors by hand. It is hidden
   at WM_INITDIALOG and toggled by IDC_CUSTOM_TOGGLE. Nothing in this group
   re-derives anything - IDC_SCREEN_CHOOSE and IDC_REMATCH are the only two
   controls that ever overwrite a color the user set by hand.
   The height below (268) is the *expanded* height - everything has to fit in
   the template. advanced_colors_dialog_proc shrinks the dialog to end just
   below the IDC_CUSTOM_TOGGLE row before it is ever shown, and measures that
   collapsed height from the toggle button's own position rather than from a
   second hardcoded number here.
   That is also why OK/Cancel sit *above* the group instead of at the bottom:
   expanding then needs no control to move, only the dialog to grow. Vista+
   task dialogs put their expando content below the buttons the same way. */
IDD_ADVANCED_COLORS DIALOGEX 0, 0, 190, 268
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Advanced Colors"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Pick one color for the screen. The active pixel and sprite shadow colors are matched to it automatically.",
                    -1, 7, 7, 176, 18
    PUSHBUTTON      "Choose Screen Color...", IDC_SCREEN_CHOOSE, 7, 29, 100, 14

    CONTROL         "", IDC_COLOR_PREVIEW, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE | WS_BORDER,
                    7, 49, 176, 46

    AUTOCHECKBOX    "Sprite shadows (LCD ghosting trail)", IDC_SHADOWS_ENABLE, 7, 101, 176, 10

    PUSHBUTTON      "Custom Colors >>", IDC_CUSTOM_TOGGLE, 7, 117, 70, 14
    DEFPUSHBUTTON   "OK",     IDOK,     79, 117, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 133, 117, 50, 14

    GROUPBOX        "Custom Colors", IDC_CUSTOM_GROUP, 7, 138, 176, 123
    LTEXT           "Screen (background) color (RRGGBB hex):", IDC_CUSTOM_BG_LABEL, 14, 151, 162, 10
    EDITTEXT        IDC_BG_HEX, 14, 162, 60, 14, ES_AUTOHSCROLL | ES_UPPERCASE
    PUSHBUTTON      "Choose...", IDC_BG_CHOOSE, 79, 161, 55, 14
    LTEXT           "Active pixel color (RRGGBB hex):", IDC_CUSTOM_PIXEL_LABEL, 14, 182, 162, 10
    EDITTEXT        IDC_PIXEL_HEX, 14, 193, 60, 14, ES_AUTOHSCROLL | ES_UPPERCASE
    PUSHBUTTON      "Choose...", IDC_PIXEL_CHOOSE, 79, 192, 55, 14
    LTEXT           "Sprite shadow color (RRGGBB hex):", IDC_CUSTOM_SHADOW_LABEL, 14, 213, 162, 10
    EDITTEXT        IDC_SHADOW_HEX, 14, 224, 60, 14, ES_AUTOHSCROLL | ES_UPPERCASE
    PUSHBUTTON      "Choose...", IDC_SHADOW_CHOOSE, 79, 223, 55, 14
    PUSHBUTTON      "Match to Screen Color", IDC_REMATCH, 14, 242, 100, 14
END

/* Rows are Up/Down/Left/Right/Fire/Debug Log/Reset/Save State/Load State,
   matching IDC_REMAP_LABEL_BASE/IDC_REMAP_CHANGE_BASE's fixed +0..+8 order
   in resource.h. The current-key label (e.g. "Up") is filled in
   dynamically at WM_INITDIALOG, not here. */
IDD_REMAP_CONTROLS DIALOGEX 0, 0, 190, 196
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Remap Controls"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Up:", -1, 7, 11, 40, 10
    LTEXT           "", IDC_REMAP_LABEL_BASE + 0, 50, 11, 70, 10
    PUSHBUTTON      "Change...", IDC_REMAP_CHANGE_BASE + 0, 125, 9, 58, 14

    LTEXT           "Down:", -1, 7, 29, 40, 10
    LTEXT           "", IDC_REMAP_LABEL_BASE + 1, 50, 29, 70, 10
    PUSHBUTTON      "Change...", IDC_REMAP_CHANGE_BASE + 1, 125, 27, 58, 14

    LTEXT           "Left:", -1, 7, 47, 40, 10
    LTEXT           "", IDC_REMAP_LABEL_BASE + 2, 50, 47, 70, 10
    PUSHBUTTON      "Change...", IDC_REMAP_CHANGE_BASE + 2, 125, 45, 58, 14

    LTEXT           "Right:", -1, 7, 65, 40, 10
    LTEXT           "", IDC_REMAP_LABEL_BASE + 3, 50, 65, 70, 10
    PUSHBUTTON      "Change...", IDC_REMAP_CHANGE_BASE + 3, 125, 63, 58, 14

    LTEXT           "Fire/Action:", -1, 7, 83, 40, 10
    LTEXT           "", IDC_REMAP_LABEL_BASE + 4, 50, 83, 70, 10
    PUSHBUTTON      "Change...", IDC_REMAP_CHANGE_BASE + 4, 125, 81, 58, 14

    LTEXT           "Debug Log:", -1, 7, 101, 40, 10
    LTEXT           "", IDC_REMAP_LABEL_BASE + 5, 50, 101, 70, 10
    PUSHBUTTON      "Change...", IDC_REMAP_CHANGE_BASE + 5, 125, 99, 58, 14

    LTEXT           "Reset:", -1, 7, 119, 40, 10
    LTEXT           "", IDC_REMAP_LABEL_BASE + 6, 50, 119, 70, 10
    PUSHBUTTON      "Change...", IDC_REMAP_CHANGE_BASE + 6, 125, 117, 58, 14

    LTEXT           "Save State:", -1, 7, 137, 40, 10
    LTEXT           "", IDC_REMAP_LABEL_BASE + 7, 50, 137, 70, 10
    PUSHBUTTON      "Change...", IDC_REMAP_CHANGE_BASE + 7, 125, 135, 58, 14

    LTEXT           "Load State:", -1, 7, 155, 40, 10
    LTEXT           "", IDC_REMAP_LABEL_BASE + 8, 50, 155, 70, 10
    PUSHBUTTON      "Change...", IDC_REMAP_CHANGE_BASE + 8, 125, 153, 58, 14

    DEFPUSHBUTTON   "Close", IDOK, 66, 175, 50, 14
END

/* Purely informational - shown modeless (not via DialogBoxParam) while
   capture_next_key waits for a keypress, so it deliberately has no
   buttons and no title bar: there's nothing to confirm or navigate, just
   press a key or Esc. */
IDD_CAPTURE_PROMPT DIALOGEX 0, 0, 220, 40
STYLE DS_SETFONT | WS_POPUP | WS_BORDER
FONT 8, "MS Shell Dlg"
BEGIN
    CTEXT           "", IDC_CAPTURE_PROMPT_TEXT, 8, 8, 204, 24
END

/* The version line's actual text is set at WM_INITDIALOG (POKKETSTATION_
   VERSION lives in main.c, not here). SysLink (requires ComCtl32 v6 - see
   the /manifestdependency pragma in main.c) renders its href as a normal
   clickable, underlined-on-hover hyperlink; about_dialog_proc's WM_NOTIFY/
   NM_CLICK handler is what actually opens it via ShellExecuteA - both the
   repo link and the license link below use the same mechanism. */
IDD_ABOUT DIALOGEX 0, 0, 200, 96
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About pokketstation"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "", IDC_ABOUT_VERSION, 7, 7, 186, 10
    LTEXT           "An open-source Sony PocketStation emulator.", -1, 7, 20, 186, 18
    CONTROL         "<a href=""https://github.com/mentalfoundry/pokketstation"">https://github.com/mentalfoundry/pokketstation</a>",
                    IDC_ABOUT_LINK, "SysLink", WS_TABSTOP, 7, 42, 186, 12
    CONTROL         "Licensed under the <a href=""https://www.gnu.org/licenses/gpl-3.0.html"">GNU GPLv3</a> (see LICENSE).",
                    IDC_ABOUT_LICENSE_LINK, "SysLink", WS_TABSTOP, 7, 58, 186, 12
    DEFPUSHBUTTON   "OK", IDOK, 75, 76, 50, 14
END
